<odoo>
	<record id="view_transit_picking_tree" model="ir.ui.view">
		<field name="name">transit.picking.tree</field>
		<field name="model">transit.picking</field>
		<field name="arch" type="xml">
			<list
				edit="0" create="0" delete="0"
				decoration-muted="state == 'cancel'"
				decoration-danger="(is_very_late or has_mismatch) and state != 'cancel'"
				decoration-warning="is_late and not is_very_late and not has_mismatch and state != 'cancel'"
				decoration-info="is_today and not is_late and not has_mismatch and state != 'cancel'"
				decoration-primary="src_picking_state == 'done' and dest_picking_state != 'done' and not is_late and not has_mismatch and state != 'cancel'"
				decoration-success="src_picking_state == 'done' and dest_picking_state == 'done' and not has_mismatch and state != 'cancel'"
			>
				<field name="company_id" optional="hide"/>
				<field name="transit_order_id_display" string="Transit Order" optional="hide"/>
				<field name="state" optional="hide" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'assigned'" decoration-primary="state == 'in_progress'" decoration-success="state == 'done'" decoration-muted="state == 'cancel'"/>
				<field name="scheduled_date" widget="datetime"/>
				<field name="transit_date_done" widget="datetime" optional="hide"/>
				<field name="src_picking_id"/>
				<field name="src_picking_state" widget="badge" decoration-info="src_picking_state == 'draft'" decoration-warning="src_picking_state == 'assigned'" decoration-primary="src_picking_state == 'in_progress'" decoration-success="src_picking_state == 'done'" decoration-muted="src_picking_state == 'cancel'"/>
				<field name="dest_picking_id"/>
				<field name="dest_picking_state" widget="badge" decoration-info="dest_picking_state == 'draft'" decoration-warning="dest_picking_state == 'assigned'" decoration-primary="dest_picking_state == 'in_progress'" decoration-success="dest_picking_state == 'done'" decoration-muted="dest_picking_state == 'cancel'"/>
				<field name="has_mismatch" column_invisible="1"/>
				<field name="is_late" column_invisible="1"/>
				<field name="is_today" column_invisible="1"/>
				<field name="is_very_late" column_invisible="1"/>
				<field name="src_picking_state" column_invisible="1"/>
				<field name="dest_picking_state" column_invisible="1"/>
			</list>
		</field>
	</record>

	<record id="view_transit_picking_form" model="ir.ui.view">
		<field name="name">transit.picking.form</field>
		<field name="model">transit.picking</field>
		<field name="arch" type="xml">
			<form class="o_transit_picking">
				<style>
					.o_transit_picking .o_transit_banner_table {
						display: grid;
						grid-template-columns: max-content 1fr;
						gap: 6px 0;
					}
					.o_transit_picking .o_transit_banner_row {
						display: contents; /* each row's children participate in the parent grid */
					}
					.o_transit_picking .o_transit_banner_label {
						display: flex;
						align-items: center;
						font-weight: 700;
						font-size: 0.75rem;
						text-transform: uppercase;
						letter-spacing: 0.05em;
						white-space: nowrap;
						padding: 8px 16px 8px 12px;
						border-radius: 4px 0 0 4px;
					}
					.o_transit_picking .o_transit_banner_content {
						display: flex;
						align-items: center;
						gap: 4px;
						padding: 8px 12px;
						border-radius: 0 4px 4px 0;
					}
				</style>
				<header>
					<button name="action_cancel" string="Cancel" class="btn btn-primary" type="object" invisible="(src_picking_state in ('done', 'cancel')) or state == 'in_progress'"/>
					<button name="action_stop" string="Stop" class="btn btn-outline-danger" type="object" invisible="(src_picking_state in ('done', 'cancel')) or state != 'in_progress'"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,assigned,in_progress,done" clickable="0"/>
				</header>

				<sheet>
					<widget name="web_ribbon" text="Mismatch Detected" bg_color="text-bg-danger" invisible="not has_mismatch"/>

					<div class="oe_title">
						<h1>
							<field name="transit_order_id_display" readonly="1" decoration-muted="state == 'cancel'" decoration-success="src_picking_state == 'done' and dest_picking_state == 'done' and not has_mismatch" decoration-primary="src_picking_state == 'done' and dest_picking_state != 'done' and not is_late and not has_mismatch" decoration-info="is_today and not is_late" decoration-warning="is_late and not is_very_late and not has_mismatch" decoration-danger="is_very_late or has_mismatch"/>
						</h1>
					</div>

					<!-- Hidden fields used for decorations and invisible conditions -->
					<field name="has_mismatch" invisible="1"/>
					<field name="is_late" invisible="1"/>
					<field name="is_today" invisible="1"/>
					<field name="is_very_late" invisible="1"/>
					<field name="src_picking_state" invisible="1"/>
					<field name="dest_picking_state" invisible="1"/>
					<field name="backorder_parent_id" invisible="1"/>
					<field name="backorder_child_ids" invisible="1"/>

					<group>
						<group>
							<field name="src_company_id" readonly="1"/>
							<field name="dest_company_id" readonly="1"/>
							<field name="company_id" readonly="1" string="Ordering Company"/>
							<field name="transit_location_id" readonly="1"/>
						</group>
						<group>
							<field name="scheduled_date" readonly="1"/>
							<field name="transit_date_done" widget="datetime" readonly="1" invisible="state not in ['done', 'cancel']"/>
						</group>
					</group>

					<!-- BACKORDER OF banner — HTML rendered cross-company (going UP the chain) -->
					<div invisible="not backorder_parent_id">
						<field name="backorder_parent_html" widget="html" readonly="1" nolabel="1"/>
					</div>

					<!-- DELEGATED FROM banner — HTML rendered cross-company (going UP the chain) -->
					<div invisible="not delegation_id">
						<field name="delegation_id_html" widget="html" readonly="1" nolabel="1"/>
					</div>

					<!-- ROUTE banner — stays as XML grid row to support the inline Cancel button -->
					<div class="o_transit_banner_table">
						<div class="o_transit_banner_row">
							<span class="o_transit_banner_label text-muted" style="background:#f8f9fa; border:1px solid #dee2e6; border-right:none;">
								<i class="fa fa-exchange me-1"/> ROUTE
							</span>
							<div class="o_transit_banner_content" style="background:#f8f9fa; border:1px solid #dee2e6; border-left:none;">
								<i class="fa fa-sign-out text-muted"/>
								<span class="text-muted small fw-bold text-uppercase me-1">Delivery</span>
								<field name="src_picking_id" readonly="1" nolabel="1" options="{'no_open': False}" class="fw-semibold"/>
								<field name="src_picking_state" widget="badge" nolabel="1" readonly="1" decoration-info="src_picking_state == 'draft'" decoration-warning="src_picking_state == 'assigned'" decoration-primary="src_picking_state == 'in_progress'" decoration-success="src_picking_state == 'done'" decoration-muted="src_picking_state == 'cancel'"/>
								<i class="fa fa-long-arrow-right text-muted mx-1"/>
								<i class="fa fa-sign-in text-muted"/>
								<span class="text-muted small fw-bold text-uppercase mx-1">Receipt</span>
								<field name="dest_picking_id" readonly="1" nolabel="1" options="{'no_open': False}" class="fw-semibold"/>
								<field name="dest_picking_state" widget="badge" nolabel="1" readonly="1" decoration-info="dest_picking_state == 'draft'" decoration-warning="dest_picking_state == 'assigned'" decoration-primary="dest_picking_state == 'in_progress'" decoration-success="dest_picking_state == 'done'" decoration-muted="dest_picking_state == 'cancel'"/>
							</div>
						</div>
					</div>

					<notebook>

						<!-- Page 1: comparison detail (always shown) -->
						<page string="Route Detail" name="route_detail">
							<field name="comparison_data" widget="transit_picking_detail"/>
						</page>

						<!-- Page 2: Backorders — HTML rendered cross-company (going DOWN the chain) -->
						<page string="Backorders" name="backorders" invisible="not backorder_child_ids">
							<field name="backorder_child_ids_html" widget="html" readonly="1" nolabel="1"/>
						</page>

						<!-- Page 3: Delegated Routes — HTML rendered cross-company (going DOWN the chain) -->
						<page string="Delegated Routes" name="delegated_routes" invisible="not delegation_ids">
							<field name="delegation_ids_html" widget="html" readonly="1" nolabel="1"/>
						</page>

					</notebook>

				</sheet>
			</form>
		</field>
	</record>

	<record id="view_transit_picking_search" model="ir.ui.view">
		<field name="name">transit.picking.search</field>
		<field name="model">transit.picking</field>
		<field name="arch" type="xml">
			<search>
				<filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
			</search>
		</field>
	</record>

	<record id="action_transit_picking" model="ir.actions.act_window">
		<field name="name">Transit Pickings</field>
		<field name="res_model">transit.picking</field>
		<field name="view_mode">list,form,search</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Manage inter-company transit pickings here.
			</p>
		</field>
	</record>
</odoo>